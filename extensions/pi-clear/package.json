  "description": "Rewind a Pi session to before its first message as a new tree branch \u2014 /clear as the counter to /new",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ariel Sakin",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "fork",
    "worktree"
  ],
