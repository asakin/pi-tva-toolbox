{
  "name": "pi-tva-toolbox",
  "version": "0.1.0",
  "description": "Pi extensions for time travel, session trees, and forks",
  "author": "Ariel Sakin",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "files": [
    "extensions/*/src/**",
    "!**/*.test.ts",
    "extensions/*/README.md",
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "workspaces": [
    "extensions/*"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-clear/src/index.ts",
      "./extensions/pi-fork-off/src/index.ts",
      "./extensions/pi-pluck/src/index.ts",
      "./extensions/pi-pruner/src/index.ts",
      "./extensions/pi-time-heist/src/index.ts",
      "./extensions/pi-version-sentinel/src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakin/pi-tva-toolbox.git"
  }
}
