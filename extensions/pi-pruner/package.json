{
  "name": "@arielsakin/pi-pruner",
  "version": "0.1.0",
  "description": "Prune dead timeline branches from a Pi session by label",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ariel Sakin",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "prune",
    "tree"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@arielsakin/pi-tva-lib": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakin/pi-tva-toolbox.git",
    "directory": "extensions/pi-pruner"
  },
  "bugs": {
    "url": "https://github.com/asakin/pi-tva-toolbox/issues"
  },
  "homepage": "https://github.com/asakin/pi-tva-toolbox#readme"
}
