{
  "name": "pi-tva-toolbox",
  "version": "0.1.0",
  "description": "Pi extensions for time travel, session trees, and forks",
  "author": "Ariel Sakin",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "workspaces": [
    "extensions/*"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-clear/src/clear.ts",
      "./extensions/pi-fork-off/src/fork-off.ts",
      "./extensions/pi-pruner/src/index.ts",
      "./extensions/pi-time-heist/src/heist.ts",
      "./extensions/pi-version-sentinel/src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakin/pi-tva-toolbox.git"
  }
}
