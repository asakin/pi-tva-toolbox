{
  "name": "pi-tva-toolbox",
  "version": "0.1.0",
  "description": "Pi extensions for time travel, session trees, and forks",
  "author": "Ariel Sakin",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "files": [
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "workspaces": [
    "lib",
    "extensions/*"
  ],
  "pi": {
    "extensions": [
      "node_modules/@arielsakin/pi-clear/src/index.ts",
      "node_modules/@arielsakin/pi-fork-off/src/index.ts",
      "node_modules/@arielsakin/pi-pluck/src/index.ts",
      "node_modules/@arielsakin/pi-pruner/src/index.ts",
      "node_modules/@arielsakin/pi-time-heist/src/index.ts",
      "node_modules/@arielsakin/pi-version-sentinel/src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "node --test \"scripts/*.test.mjs\" && npm run test --workspaces --if-present",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@arielsakin/pi-clear": "0.1.0",
    "@arielsakin/pi-fork-off": "0.1.0",
    "@arielsakin/pi-pluck": "0.1.0",
    "@arielsakin/pi-pruner": "0.1.0",
    "@arielsakin/pi-time-heist": "0.1.0",
    "@arielsakin/pi-version-sentinel": "0.1.0"
  },
  "bundleDependencies": [
    "@arielsakin/pi-clear",
    "@arielsakin/pi-fork-off",
    "@arielsakin/pi-pluck",
    "@arielsakin/pi-pruner",
    "@arielsakin/pi-time-heist",
    "@arielsakin/pi-version-sentinel"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakin/pi-tva-toolbox.git"
  }
}
